# Copy to .env.local to try real sign-in (Amazon Cognito) while developing. See infra/README.md.
# Leave both empty to keep the browser-only demo login. These are public values, not secrets.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Social buttons to show: google, microsoft, or both separated by a comma. Email is always offered.
# Only add one once it is connected in Cognito, or its button will fail.
VITE_COGNITO_PROVIDERS=
